{
  "_comment": "Terms banned by GLOSSARY.md. Patterns are PCRE (case-insensitive, UTF-8) and are matched against the visible text only: HTML tags and URLs are ignored. Add a key to 'allow' for a justified exception.",
  "rules": [
    { "pattern": "\\bperihalan\\b", "use": "penerangan", "en": "Description" },
    { "pattern": "\\bpenggantian\\b", "use": "pengatasan", "en": "Override" },
    { "pattern": "\\bemel\\b", "use": "e-mel", "en": "Email" },
    { "pattern": "(?<![-\\w])(?<!paling )baru(?![-\\w])(?!\\s+(?:di\\w+|sahaja|saja))", "use": "baharu", "en": "New ('baru' is only for 'just / recently')" },
    { "pattern": "\\bplugin\\b", "use": "pemalam", "en": "Plugin" },
    { "pattern": "\\b(?:tapak web|laman sesawang)\\b", "use": "laman web", "en": "Website" },
    { "pattern": "\\bdilepaskan\\b", "use": "didaftar masuk", "en": "Checked in" },
    { "pattern": "\\b(?:di|ber)?persatu(?:an|kan)\\b", "use": "perkaitan / dikaitkan", "en": "Association" },
    { "pattern": "\\bdisemak keluar\\b", "use": "didaftar keluar", "en": "Checked out" },
    { "pattern": "\\b(?:pengisihan|pengaturan)\\b", "use": "susunan", "en": "Ordering" },
    { "pattern": "\\b(?:capaian|jumlah dilihat)\\b", "use": "tontonan (Hits) / akses (Access)", "en": "Hits / Access" }
  ],
  "allow": []
}
